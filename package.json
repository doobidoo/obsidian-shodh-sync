{
  "name": "obsidian-shodh-sync",
  "version": "0.1.0",
  "description": "Shodh memory sync for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs --minify",
    "version": "node version-bump.mjs && npm run build",
    "reset": "git checkout ./manifest.json -- && git checkout ./versions.json -- && rm src/main.ts && npm i"
  },
  "devDependencies": {
    "@types/node": "16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}